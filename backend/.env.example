# ===== Server =====
PORT=5000

# ===== Database =====
# برای MongoDB Atlas (پیشنهادی):
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/fashion_store

# یا برای MongoDB محلی:
# MONGODB_URI=mongodb://localhost:27017/fashion_store

# ===== JWT =====
JWT_SECRET=your_super_secret_jwt_key_change_this_to_random_string
JWT_EXPIRE=7d

# ===== Admin User (اختیاری) =====
# این مقادیر برای ساخت ادمین اولیه استفاده می‌شن
ADMIN_EMAIL=admin@fashion.com
ADMIN_PASSWORD=Admin123!
ADMIN_FULLNAME=مدیر فروشگاه